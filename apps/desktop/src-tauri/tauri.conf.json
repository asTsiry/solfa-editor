{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solfa Editor",
  "version": "0.1.0",
  "identifier": "app.solfa.editor",
  "build": {
    "frontendDist": "../../pwa/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Solfa Editor",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
